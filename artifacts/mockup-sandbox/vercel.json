{
  "installCommand": "pnpm install --no-frozen-lockfile",
  "headers": [
    {
      "source": "/home-header-reference-exact.webp",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/jpeg"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/index.html"
    }
  ]
}
